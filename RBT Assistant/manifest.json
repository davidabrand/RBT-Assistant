{
  "manifest_version": 3,
  "name": "Office Puzzle RBT Assistant",
  "version": "1.1.107",
  "description": "Fast, low-friction Office Puzzle RBT workflow with searchable program autofill, instant day selection, safe batch entry, and verified writes.",
  "permissions": [
    "storage",
    "sidePanel",
    "scripting",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.officepuzzle.com/*",
    "https://officepuzzle.com/*"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "action": {
    "default_title": "Office Puzzle RBT Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.officepuzzle.com/*",
        "https://officepuzzle.com/*"
      ],
      "js": [
        "scripts/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "short_name": "RBT Assistant"
}
